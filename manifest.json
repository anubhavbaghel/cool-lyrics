{
  "manifest_version": 3,
  "name": "Cool Lyrics - Pitch Black Synchronized Lyrics",
  "version": "1.0.0",
  "description": "Cinematic pitch-black synchronized lyrics for Spotify, YouTube Music, and YouTube.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Cool Lyrics"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://open.spotify.com/*",
    "*://music.youtube.com/*",
    "*://www.youtube.com/*",
    "https://lrclib.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://open.spotify.com/*",
        "*://music.youtube.com/*",
        "*://www.youtube.com/*"
      ],
      "js": [
        "utils/title-cleaner.js",
        "utils/lrc-parser.js",
        "utils/lyrics-api.js",
        "content/overlay.js",
        "content/content.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "cinema/*"
      ],
      "matches": [
        "*://open.spotify.com/*",
        "*://music.youtube.com/*",
        "*://www.youtube.com/*"
      ]
    }
  ],
  "commands": {
    "toggle-cinema-overlay": {
      "suggested_key": {
        "default": "Alt+L"
      },
      "description": "Toggle in-page Pitch Black Cinema overlay"
    },
    "open-cinema-tab": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Open Standalone Cinema Tab"
    }
  }
}
